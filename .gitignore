# If you unzip a design export at the repo root to look at it, don't commit
# the loose extracted copy — the canonical extracted version lives (tracked)
# under design/<name>/, e.g. design/vibe-check/.
/*.dc.html
/_ds/

# Common cruft
.DS_Store
node_modules/
dist/
build/
.env
.vercel
.env*
# ...except committed templates
!**/.env.example

# public/ is now BUILD OUTPUT (the app's static web export, produced by
# `npm run build` -> app's `build:web` -> `expo export ... --output-dir
# ../public`). Regenerated fresh on every Vercel deploy — don't hand-edit
# or commit it.
/public/

# Expo/React Native artifacts are covered by app/.gitignore (generated by
# `create-expo-app`) — no need to duplicate that here.
