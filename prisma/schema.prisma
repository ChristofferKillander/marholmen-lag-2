generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per posted vibe. Backs GET/POST /vibes and is aggregated on
// read for GET /pulse (energy average, mood, colour board, hype leaders).
model Vibe {
  id        String   @id @default(cuid())
  name      String
  emoji     String
  status    String
  color     String
  energy    Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}
